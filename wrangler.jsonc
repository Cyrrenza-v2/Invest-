{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invest-broker-api-test",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-12",
  "vars": {
    "APP_MODE": "test"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LEDGER",
        "class_name": "LedgerDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LedgerDurableObject"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
